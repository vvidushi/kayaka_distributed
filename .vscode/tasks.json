{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install: Backend",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "install"
      }
    },
    {
      "label": "Install: Frontend",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "install"
      }
    },
    {
      "label": "Install: AI-Agent",
      "type": "shell",
      "command": "./update-requirements.sh",
      "windows": {
        "command": "powershell.exe -ExecutionPolicy Bypass -File ./update-requirements.ps1"
      },
      "options": {
        "cwd": "${workspaceFolder}/ai-agent"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "install"
      }
    },
    {
      "label": "Install All",
      "dependsOn": [
        "Install: Backend",
        "Install: Frontend",
        "Install: AI-Agent"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "install"
      }
    },
    {
      "label": "Run: Backend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "run",
        "focus": true
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "default"
      }
    },
    {
      "label": "Run: Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "run",
        "focus": true
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "default"
      }
    },
    {
      "label": "Run: AI-Agent",
      "type": "shell",
      "command": "source .venv/bin/activate && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          ".\\.venv\\Scripts\\Activate.ps1; uvicorn main:app --reload --host 0.0.0.0 --port 8000"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}/ai-agent"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "run",
        "focus": true
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "default"
      }
    },
    {
      "label": "Run All",
      "dependsOn": [
        "Run: Backend",
        "Run: Frontend",
        "Run: AI-Agent"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "run"
      }
    }
  ]
}

