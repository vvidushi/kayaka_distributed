# ===================================================
# KAYAK AI-AGENT ENVIRONMENT CONFIGURATION (LOCALHOST)
# ===================================================
# Copy this file to .env and update with your values
# Command: cp env.localhost.template .env

# Service Configuration
PORT=8000
LOG_LEVEL=INFO

# ===================================================
# DATABASE CONNECTIONS (LOCALHOST)
# ===================================================

# PostgreSQL - Localhost Configuration (Optional)
# Uncomment if using local PostgreSQL instead of Supabase
# DATABASE_URL=postgresql://postgres:password@localhost:5432/kayak

# Redis - Localhost Configuration (Optional)
# Uncomment if running local Redis
# REDIS_URL=redis://localhost:6379
# AI_AGENT_REDIS_URL=redis://localhost:6379

# MongoDB - Localhost Configuration
# Note: If your AI agent needs MongoDB, configure it here
MONGODB_URI=mongodb://root:password@localhost:27017/kayak?authSource=admin

# ===================================================
# AI/LLM CONFIGURATION
# ===================================================
# OpenAI API Key (if using OpenAI)
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (if using Claude)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google AI API Key (if using Google AI)
# GOOGLE_AI_API_KEY=your-google-api-key-here

# Model Selection
# LLM_PROVIDER=openai  # Options: openai, anthropic, google
# LLM_MODEL=gpt-4  # Or: claude-3-opus, gemini-pro

# ===================================================
# LANGCHAIN CONFIGURATION
# ===================================================
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langchain-api-key
# LANGCHAIN_PROJECT=kayak-ai-agent

# ===================================================
# MCP (Model Context Protocol) CONFIGURATION
# ===================================================
# MCP_SERVER_URL=http://localhost:8001
# MCP_ENABLED=false

# ===================================================
# BACKEND API CONFIGURATION
# ===================================================
# Backend API URL for the AI agent to communicate with backend
BACKEND_API_URL=http://localhost:3000

# ===================================================
# CACHE CONFIGURATION
# ===================================================
CACHE_ENABLED=false
CACHE_TTL=3600

# ===================================================
# SEARCH & QUERY CONFIGURATION
# ===================================================
MAX_SEARCH_RESULTS=20
DEFAULT_SEARCH_LIMIT=10

# ===================================================
# DEVELOPMENT/DEBUG
# ===================================================
DEBUG=false
VERBOSE_LOGGING=false

