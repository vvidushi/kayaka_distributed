{
  "name": "kayak-backend",
  "version": "1.0.0",
  "description": "Kayak Simulation Platform Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPattern=tests/.*\\.test\\.cjs",
    "test:connection": "node test-connection.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "seed:test-users": "node scripts/seed-test-users.js",
    "seed:us-data": "node scripts/seed-us-data.js",
    "load:kaggle-data": "node scripts/load-kaggle-data.js",
    "create:indexes": "node scripts/create-indexes.js",
    "migrate:users": "node scripts/run-users-migration.js",
    "migrate:payments": "node scripts/run-payments-migration.js",
    "kafka:create-topics": "node scripts/create-kafka-topics.js"
  },
  "keywords": [
    "kayak",
    "travel",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.3.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "prom-client": "^15.1.2",
    "redis": "^4.6.12",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.19.0",
    "supertest": "^6.3.3"
  }
}
