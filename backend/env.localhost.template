# ===================================================
# KAYAK BACKEND ENVIRONMENT CONFIGURATION (LOCALHOST)
# ===================================================
# Copy this file to .env and update with your values
# Command: cp env.localhost.template .env

# Node Environment
NODE_ENV=development
PORT=3000

# ===================================================
# DATABASE CONNECTIONS (LOCALHOST)
# ===================================================

# MongoDB - Localhost Configuration
# Uses local MongoDB running on docker-compose or locally
MONGODB_URI=mongodb://root:password@localhost:27017/kayak?authSource=admin

# PostgreSQL - Localhost Configuration (Optional - if needed)
# Uncomment if using local PostgreSQL instead of Supabase
# DATABASE_URL=postgresql://postgres:password@localhost:5432/kayak

# Redis - Localhost Configuration
# Uncomment if running local Redis on docker-compose
# REDIS_URL=redis://localhost:6379
# Or disable Redis caching entirely:
CACHE_ENABLED=false

# ===================================================
# SECURITY SECRETS
# ===================================================
# Generate new secrets using: node scripts/generate-secrets.js
# Or use: openssl rand -hex 64

JWT_SECRET=your-generated-jwt-secret-here-minimum-64-characters-use-generate-secrets-script
SESSION_SECRET=your-generated-session-secret-here-minimum-64-characters-different-from-jwt
JWT_EXPIRES_IN=24h
SESSION_MAX_AGE=86400000

# ===================================================
# AI AGENT SERVICE
# ===================================================
# URL to AI Agent service (localhost)
AI_AGENT_URL=http://localhost:8000

# ===================================================
# FIREBASE AUTHENTICATION
# ===================================================
# Get these from Firebase Console: https://console.firebase.google.com/
# Project Settings > Service Accounts > Generate New Private Key
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="your-firebase-private-key-here"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ===================================================
# KAFKA CONFIGURATION (OPTIONAL)
# ===================================================
# Uncomment if using Kafka for event streaming
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=kayak-backend
# KAFKA_GROUP_ID=kayak-consumer-group

# ===================================================
# CORS & API CONFIGURATION
# ===================================================
# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# ===================================================
# FILE UPLOAD CONFIGURATION
# ===================================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ===================================================
# LOGGING
# ===================================================
LOG_LEVEL=debug

