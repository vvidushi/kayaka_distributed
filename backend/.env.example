# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Supabase PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://[USERNAME]:[PASSWORD]@[CLUSTER].mongodb.net/kayak?retryWrites=true&w=majority

# Redis Configuration (Redis Cloud or Local)
REDIS_URL=redis://default:[PASSWORD]@[HOST]:[PORT]
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_SSL_CA_PATH=./kafka/ca.pem
KAFKA_SSL_CERT_PATH=./kafka/service.cert
KAFKA_SSL_KEY_PATH=./kafka/service.key
KAFKA_CLIENT_ID=kayak-backend
KAFKA_ENABLED=true

# JWT Configuration
JWT_SECRET=generate-using-node-scripts/generate-secrets.js
JWT_EXPIRES_IN=24h

# Session Configuration
SESSION_SECRET=generate-using-node-scripts/generate-secrets.js
SESSION_MAX_AGE=86400000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Cache
CACHE_ENABLED=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=500

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"[PROJECT-ID]","private_key_id":"[KEY-ID]","private_key":"-----BEGIN PRIVATE KEY-----\n[KEY]\n-----END PRIVATE KEY-----\n","client_email":"[EMAIL]","client_id":"[CLIENT-ID]","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"[CERT-URL]"}
FIREBASE_STORAGE_BUCKET=[PROJECT-ID].appspot.com
